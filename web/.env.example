# Public site URL, used for metadata and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://monotch.vercel.app

# Lemon Squeezy checkout links. Store → Products → Share → copy the checkout URL.
NEXT_PUBLIC_LS_CHECKOUT_MONTHLY=
NEXT_PUBLIC_LS_CHECKOUT_YEARLY=
NEXT_PUBLIC_LS_CHECKOUT_LIFETIME=

# Direct link to the notarised .dmg (S3, R2, GitHub Releases...).
# Until this is set, the download page shows a placeholder instead of a dead button.
NEXT_PUBLIC_DOWNLOAD_URL=
